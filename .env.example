# Production/local API configuration
PORT=3001
# Create a MongoDB Atlas free cluster and use its application connection URI.
MONGODB_URI=mongodb+srv://<db-user>:<url-encoded-password>@<cluster-host>/team_sync?retryWrites=true&w=majority
MONGODB_DB_NAME=team_sync
# Set these before the first run to override demo account passwords.
DEMO_ADMIN_PASSWORD=replace-with-a-long-unique-password
DEMO_EMPLOYEE_PASSWORD=replace-with-a-long-unique-password
# For production, also set NODE_ENV=production and SERVE_STATIC=true.
# APP_ORIGIN=https://your-app.example.com
